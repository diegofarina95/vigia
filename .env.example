# --- Required in production ---------------------------------------------
VIGIA_SECRET_KEY=change-me-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGIA_ENCRYPTION_KEY=

# --- Google OAuth (leave empty when MOCK_MODE=1) -------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8110/api/auth/google/callback

# --- Behaviour ------------------------------------------------------------
# 1 = seeded demo tenant, no Google calls (UI development / demo)
MOCK_MODE=0
# 1 = treat every org as Pro (feature-flag preview; billing is TODO/Stripe)
VIGIA_PRO_OVERRIDE=0
# Where to send the browser after OAuth; empty = same origin.
# For Vite dev on :5173 use: http://localhost:5173
VIGIA_APP_URL=

# --- Tuning (optional) -----------------------------------------------------
VIGIA_SUPER_ADMIN_THRESHOLD=3
VIGIA_DORMANT_DAYS=90
VIGIA_WIDELY_GRANTED_THRESHOLD=10
# VIGIA_DKIM_SELECTORS=google,selector1,selector2

# Shown on the Privacy page as the GDPR contact
VIGIA_CONTACT_EMAIL=

# --- Escaneos programados + alertas por email (opcional) -------------------
VIGIA_SCHEDULER=1
VIGIA_SCHEDULER_INTERVAL_MIN=15
VIGIA_BASE_URL=
VIGIA_SMTP_HOST=
VIGIA_SMTP_PORT=587
VIGIA_SMTP_USER=
VIGIA_SMTP_PASSWORD=
VIGIA_SMTP_FROM=
VIGIA_SMTP_STARTTLS=1
VIGIA_SMTP_SSL=0

# --- Publicación tras un proxy inverso (opcional) --------------------------
VIGIA_PREFIX=
VIGIA_COOKIE_SECURE=0
